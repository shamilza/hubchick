# Database
DATABASE_URL=postgresql://hubchick:hubchick_dev_password@localhost:5432/hubchick_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@hubchick.com
EMAIL_FROM_NAME=Hubchick

# Google Calendar
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Yandex Calendar
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
YANDEX_REDIRECT_URI=http://localhost:8000/api/v1/auth/yandex/callback

# Application
ENVIRONMENT=development
DEBUG=True
APP_NAME=Hubchick CRM
APP_VERSION=1.0.0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
